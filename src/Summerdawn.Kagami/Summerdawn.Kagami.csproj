<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="NoWarn">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <AssemblyName>kagami</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Show simple version number -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- Settings for trimmed/AOT deployment -->
  <PropertyGroup>
    <!-- Enable trimming and AOT analyzers and warnings and indicate that NuGet package is trim-compatible -->
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Enable trimming-compatible configuration binding -->
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <!-- Suppress IL2104 because external packages emit only package-internal trim diagnostics (currently unused suppressions); no Kagami call site is identified. -->
    <!-- Treat NoWarn as local so this suppression is retained alongside command-line warning switches. -->
    <NoWarn>$(NoWarn);IL2104</NoWarn>
  </PropertyGroup>

  <!-- NuGet properties -->
  <PropertyGroup>
    <PackageId>Summerdawn.Kagami</PackageId>
    <Description>Kagami is a CLI tool and daemon to import, export and synchronize contacts.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>kagami</ToolCommandName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embed built-in appsettings files as resources and prevent them from being copied as content -->
    <Content Remove="appsettings.json" />
    <Content Remove="appsettings.Verbose.json" />
    <EmbeddedResource Include="appsettings.json" />
    <EmbeddedResource Include="appsettings.Verbose.json" />
    <!-- Exclude appsettings.*.json from packing and publishing -->
    <Content Update="appsettings.*.json" CopyToOutputDirectory="PreserveNewest" Pack="false" CopyToPublishDirectory="Never" />
    <!-- Include README.md in packing and publishing -->
    <None Include="README.md" Pack="true" PackagePath="/" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Summerdawn.Kagami.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.6" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.6" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.6" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.6" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.6" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.6" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.5.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.6" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.6" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.6" />
    <PackageReference Include="System.CommandLine" Version="2.0.6" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.Extensions.Logging" />
    <Using Include="Microsoft.Extensions.Options" />
  </ItemGroup>

</Project>
