// Note: To make the project publishable as a standalone executable, this 
// appsettings.json file is configured to be an _embedded resource_, not content.
{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",

      // Suppress the verbose HttpClient/Polly log spam by default.
      "System.Net.Http.HttpClient": "Warning",
      "Polly": "Warning"
    }
  }
}
